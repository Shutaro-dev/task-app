<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.task_app.mapper.RoleMapper">

    <resultMap id="RoleResultMap" type="com.example.task_app.model.Role">
        <id column="role_id" property="roleId" />
        <result column="role_name" property="roleName" />
    </resultMap>

    <select id="selectAll" resultMap="RoleResultMap">
        SELECT role_id, role_name
        FROM roles
        ORDER BY role_id
    </select>

    <select id="selectById" parameterType="java.lang.Integer" resultMap="RoleResultMap">
        SELECT role_id, role_name
        FROM roles
        WHERE role_id = #{roleId}
    </select>

    <insert id="insert" parameterType="com.example.task_app.model.Role" useGeneratedKeys="true" keyProperty="roleId">
        INSERT INTO roles (role_name, created_at, updated_at)
        VALUES (#{roleName}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
    </insert>

    <update id="update" parameterType="com.example.task_app.model.Role">
        UPDATE roles
        SET role_name = #{roleName}, updated_at = CURRENT_TIMESTAMP
        WHERE role_id = #{roleId}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM roles
        WHERE role_id = #{roleId}
    </delete>

</mapper> 