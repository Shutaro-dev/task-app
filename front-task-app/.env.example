# バックエンド(Rails API)のオリジン。本番ビルド時はデプロイ先のバックエンドURLを設定する。
# 未設定の場合はローカル開発用に http://localhost:8080 にフォールバックする。
VITE_API_BASE_URL=http://localhost:8080

# データ永続化の方式。'local'ならブラウザのlocalStorageのみで完結し、ログインも不要になる。
# 'api'にするとRails API + PostgreSQL(Cookieセッション認証あり)へ接続する従来の動作に戻る。
# 未設定の場合は暫定的に 'local' がデフォルト。
VITE_PERSISTENCE_MODE=local
